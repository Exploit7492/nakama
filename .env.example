# Local development only. Never commit a real .env.
# On Render these are set in the dashboard under Environment.

# --- Database -----------------------------------------------------------
SUPABASE_DB_USER=postgres.<project-ref>
SUPABASE_DB_PASS=change-me
SUPABASE_DB_HOST=aws-0-<region>.pooler.supabase.com
# Optional: a full DSN wins over the three above.
# DATABASE_URL=postgresql://postgres.<project-ref>:change-me@host:5432/postgres?sslmode=require
# SUPABASE_DB_PORT=5432
# SUPABASE_DB_NAME=postgres
# SUPABASE_DB_SSLMODE=require

# --- Nakama keys --------------------------------------------------------
NAKAMA_SERVER_KEY=change-me
# Optional. Keep stable across restarts or existing sessions are invalidated.
# SESSION_ENCRYPTION_KEY=
# SESSION_REFRESH_ENCRYPTION_KEY=
# CONSOLE_USERNAME=admin
# CONSOLE_PASSWORD=

# --- Keepalive ----------------------------------------------------------
# RENDER_SERVICE_URL=https://your-service.onrender.com
# PING_INTERVAL=300
